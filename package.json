{
	"name": "gneissdotrun",
	"private": true,
	"workspaces": {
		"packages": [
			"apps/*",
			"packages/*"
		],
		"catalog": {
			"dotenv": "^17.3.1",
			"zod": "^4.1.13",
			"typescript": "^5",
			"@types/node": "^25.3.0",
			"@cloudflare/workers-types": "^4.20260228.0",
			"hono": "^4.12.1",
			"@orpc/server": "^1.12.2",
			"@orpc/openapi": "^1.12.2",
			"@orpc/zod": "^1.12.2",
			"better-auth": "^1.4.18",
			"alchemy": "^0.85.1",
			"wrangler": "^4.67.0",
			"@libsql/client": "0.17.0",
			"libsql": "0.5.22",
			"@orpc/client": "^1.12.2",
			"drizzle-orm": "^0.45.1"
		}
	},
	"type": "module",
	"scripts": {
		"dev": "turbo dev",
		"build": "turbo build",
		"typecheck": "turbo typecheck",
		"check:deprecations": "bun scripts/check-deprecations.mjs",
		"dev:native": "turbo -F native dev",
		"dev:web": "turbo -F web dev",
		"dev:server": "turbo -F server dev",
		"db:push": "turbo -F @gneissdotrun/db db:push",
		"db:generate": "turbo -F @gneissdotrun/db db:generate",
		"deploy": "turbo -F @gneissdotrun/infra deploy",
		"destroy": "turbo -F @gneissdotrun/infra destroy",
		"check": "oxlint && oxfmt --write"
	},
	"dependencies": {
		"@gneissdotrun/env": "workspace:*",
		"dotenv": "catalog:",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "catalog:",
		"@gneissdotrun/config": "workspace:*",
		"@types/node": "catalog:",
		"oxfmt": "^0.34.0",
		"oxlint": "^1.49.0",
		"turbo": "^2.8.10",
		"typescript": "catalog:"
	},
	"packageManager": "bun@1.3.8"
}
